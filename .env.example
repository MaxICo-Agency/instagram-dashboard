# ───────────────────────────────────────────────────────────
# Instagram Dashboard — конфігурація
# Скопіюй у .env.local (локально) або .env (Docker) і заповни.
# ───────────────────────────────────────────────────────────

# ── Адмін-панель (вхід логін/пароль) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                 # ОБОВ'ЯЗКОВО задай свій пароль
AUTH_SECRET=                    # випадковий рядок (напр. `openssl rand -hex 32`)

# ── Instagram API ──
# Два типи підключення:
#  A) Instagram Login:  IG_API_HOST=https://graph.instagram.com  + IG_USER_ID=me
#  B) Facebook Login:   IG_API_HOST=https://graph.facebook.com   + IG_USER_ID=<ig-business-account-id>
# Дозволи токена: instagram_business_basic + instagram_business_manage_insights
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_HOST=https://graph.instagram.com
IG_GRAPH_VERSION=v21.0

# Нікнейм власника акаунта (для UTM у футтері MaxICo Labs)
IG_OWNER_HANDLE=

# Прод-захист: 1 = ніколи не показувати демо. Без токена покаже екран підключення.
IG_REQUIRE_LIVE=

# ── OpenAI (AI-рекомендації, українською) ──
# Без ключа працює офлайн-фолбек на правилах.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
