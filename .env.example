# IG Pulse — environment
# Copy to .env.local and fill in. Without IG_ACCESS_TOKEN the app runs in DEMO mode.

# Instagram API (graph.instagram.com — "Instagram API with Instagram Login")
# Token must include scope: instagram_business_basic, instagram_business_manage_insights
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=v21.0

# Reused Meta app (project "dm zahar manager"). NOTE: the app's API access is
# currently DEACTIVATED on Meta side — reactivate at developers.facebook.com
# (complete developer registration) before live data works.
META_APP_ID=
META_APP_SECRET=

# OpenAI — narrative recommendations (Ukrainian). Falls back to rule-based text if absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
