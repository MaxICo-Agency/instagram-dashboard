# Instagram Dashboard — environment
# Copy to .env.local (dev) or .env (Docker). Without IG_ACCESS_TOKEN the app
# runs in DEMO mode locally; in production set IG_REQUIRE_LIVE=1 (see below).

# --- Instagram API ---
# Two connection types are supported:
#  A) Instagram Login:  IG_API_HOST=https://graph.instagram.com  + IG_USER_ID=me (or omit)
#  B) Facebook Login:   IG_API_HOST=https://graph.facebook.com   + IG_USER_ID=<ig-business-account-id>
# Token scope required: instagram_business_basic, instagram_business_manage_insights
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_HOST=https://graph.instagram.com
IG_GRAPH_VERSION=v21.0

# Production guard: 1 = never show demo data. If no valid token, show a setup screen.
IG_REQUIRE_LIVE=

# OpenAI — narrative recommendations (Ukrainian). Falls back to rule-based text if absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
